{
  "name": "tree-sitter-lichen",
  "version": "0.1.0",
  "description": "Lichen grammar for tree-sitter",
  "main": "bindings/node",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse-examples": "tree-sitter parse \"../crates/lichen-language/examples/programs\""
  },
  "keywords": ["tree-sitter", "parser", "lichen"],
  "license": "MIT",
  "tree-sitter": [
    {
      "scope": "source.lichen",
      "file-types": ["lichen"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^lichen$"
    }
  ]
}
