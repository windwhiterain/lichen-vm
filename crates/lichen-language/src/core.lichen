Num := set(Int, Float)
in_num := t => t @in Num; let Pair := _x => (_ ! in_num, _ ! in_num)
add := operands => { operands <: Pair; operands(0) + operands(1) }
sub := operands => { operands <: Pair; operands(0) - operands(1) }
mul := operands => { operands <: Pair; operands(0) * operands(1) }
div := operands => { operands <: Pair; operands(0) / operands(1) }
less := operands => { operands <: Pair; operands(0) < operands(1) }
greater := operands => { operands <: Pair; operands(0) > operands(1) }
less_or_equal := operands => { operands <: Pair; operands(0) <= operands(1) }
greater_or_equal := operands => { operands <: Pair; operands(0) >= operands(1) }
let Pair := _x => (_ ! in_num, _ ! in_num)
