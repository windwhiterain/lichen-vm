let type_of := x => {t := _; x : t; t}
let perspective_of := x => {p := _; x # p; p}
warp := 32
KT := _x => {.I _, .O _}
K := _x => {.native _, .I _, .O _}
A := I => {.n @any : Int, .I I}
P := T <: KT _ => {.n @any : Int, .in T.I}
S := T <: KT _ => (i <: (A T.I) => _ : T.O)
BufParam := _x => {.type _, .length _}
Buf := x <: BufParam _ => {
  .native @any : $buf_type(x.type, x.length)
  .type x.type
  .length x.length
}
jit := f => {I := _; f <: (i <: I => _); O := f I; (K _){.native $jit(f), .I I, .O O}}
launch := k <: K _ => a => {a <: k.I; a # _; r := $launch(k.native, a); r : type_of (k.O); r <: k.O}
call := k <: K _ => a => {a <: k.I; a # _; r := $call(k.native, a); r : type_of (k.O); r <: k.O}
parallel := f => b : string => o : _ => {I := _; f <: (i <: I => _); (K _){.native $parallel(f, b), .I I, .O o}}
plrun := k <: K _ => a <: k.I => {r := $plrun(k.native, a, k.O); r : type_of (k.O); r <: k.O}
range := x : Int => (($range(x) : Int) # 1)
row := cfg => (($row(cfg) : Int) # 1)
col := cfg => (($col(cfg) : Int) # 1)
Read := p <: BufParam _ => {.from (Buf p) # warp, .at @any : Int}
Write := p <: BufParam _ => {.to (Buf p) # warp, .at @any : Int, .value @any : p.type}
WriteAtomic := p <: BufParam _ => {.to (Buf p) # warp, .at @any : Int, .value @any : p.type}
read := x <: Read _ => $read(x.from, x.at)
write := x <: Write _ => {r := $write(x.to, x.at, x.value); r <: (Buf _) # (perspective_of x.to)}
write_atomic := x <: WriteAtomic _ => {r := $write_atomic(x.to, x.at, x.value); r <: (Buf _) # (perspective_of x.to)}
collect := b <: Buf _ => $collect(b)
buf := x <: BufParam _ => (Buf x){.native $buf(x.type, x.length), .type x.type, .length x.length}
Mma := _x => {
  .s @any : string
  .a (Buf ((BufParam _){.type Int, .length 16})) # warp
  .b (Buf ((BufParam _){.type Int, .length 32})) # warp
  .c (Buf ((BufParam _){.type Int, .length 16})) # warp
}
mma := x <: Mma _ => {r := $mma(x.s, x.a, x.b, x.c); r <: (Buf ((BufParam _){.type Int, .length 16})) # warp}
graph := f => {f <: (x => _); $graph(f)}
graphrun := g => a => $graphrun(g, a)
