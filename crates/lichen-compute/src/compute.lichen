let type_of = x => {t = _; x: t; t}
Read = _x => struct<.from _, .at _>
Write = _x => struct<.to _, .at _, .value _>
KT = _x => struct<.I _, .O _>
K = _x => struct<.native _, .I _, .O _>
A = I => struct<.n Int, .I I>
P = T: KT T => struct<.n Int, .in T.I, .out T.O>
S = T: KT T => A T.I -> T.O
jit = f => {I = _; O = _; f: I -> O; (K _)(.native $jit(f), .I I, .O O)}
launch = k => a => {r = $launch(k.native, a); r: k.O; r}
call = k => a => $call(k.native, a)
parallel = f => b => {f: _ -> _; b: string; (struct<.native _, .sig (type_of f)>)(.native $parallel(f, b), .sig _)}
parallel_sig = f => b => s => {f: _ -> _; b: string; (struct<.native _, .sig s>)(.native $parallel(f, b), .sig s)}
plrun = k => a => $plrun(k.native, a)
range = x => $range(x)
read = (x : Read _) => $read(x.from, x.at)
write = (x : Write _) => $write(x.to, x.at, x.value)
collect = b => $collect(b)
graph = f => {f: _ -> _; $graph(f)}
graphrun = g => a => $graphrun(g, a)
