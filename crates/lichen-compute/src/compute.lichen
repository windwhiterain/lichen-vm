let type_of := x => {t := _; x: t; t}
let perspective_of := x => {p := _; x # p; p}
warp := 32
KT := {.I _, .O _}
K := {.native _, .I _, .O _}
A := {.n @any : Int, .I _}
P := {.n @any : Int, .in _}
S := _ => A -> _
BufParam := {.type _, .length _}
Buf := {.native _, .type _, .length _}
jit := f => {I := _; O := _; f: I -> O; K{.native $jit(f), .I I, .O O}}
launch := k => {k <: K; a => {a : k.I # _; {r := $launch(k.native, a); r: k.O; r}}}
call := k => {k <: K; a => {a : k.I # _; {r := $call(k.native, a); r: k.O; r}}}
parallel := f => b => o => {I := _; O := _; f: I -> O; K{.native $parallel(f, b), .I I, .O o}}
plrun := k => {k <: K; a => {a : k.I; {r := $plrun(k.native, a); r: k.O; r}}}
range := x => (($range(x): Int) # 1)
row := cfg => (($row(cfg): Int) # 1)
col := cfg => (($col(cfg): Int) # 1)
Read := {.from _, .at Int}
Write := {.to _, .at Int, .value _}
WriteAtomic := {.to _, .at Int, .value _}
read := x => {x <: Read; $read(x.from, x.at)}
write := x => {x <: Write; $write(x.to, x.at, x.value) # (perspective_of x.to)}
write_atomic := x => {x <: WriteAtomic; $write_atomic(x.to, x.at, x.value) # (perspective_of x.to)}
collect := b => {b <: Buf; $collect(b)}
buf := x => {x <: BufParam; Buf{.native $buf(x.type, x.length), .type @any, .length @any}}
Mma := {.s string, .a _, .b _, .c _}
mma := x => {x <: Mma; $mma(x.s, x.a, x.b, x.c) # warp}
graph := f => {f: _ -> _; $graph(f)}
graphrun := g => a => $graphrun(g, a)
