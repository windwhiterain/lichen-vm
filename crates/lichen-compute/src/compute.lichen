let type_of := x => {t := _; x : t; t}
let perspective_of := x => {p := _; x # p; p}
warp := 32
KT := {.I @any, .O @any}
K := {.native @any, .I @any, .O @any}
A := I => {.n @any : Int, .I I}
P := T = KT => {.n @any : Int, .in T.I}
S := T = KT => (i = (A T.I) => _ : T.O)
BufParam := {.type @any, .length @any}
Buf := x = BufParam => {
  .native @any : $buf_type(x.type, x.length)
  .type x.type
  .length x.length
}
jit := f => {I := _x => _; f = (i = (I _) => _); O := f (I _); K{.native $jit(f), .I I, .O O}}
launch := k = K => a => {a = (k.I _); a # _; r := $launch(k.native, a); r : type_of (k.O); r = k.O}
call := k = K => a => {a = (k.I _); a # _; r := $call(k.native, a); r : type_of (k.O); r = k.O}
parallel := f => b : string => o : _ => {I := _x => _; f = (i = (I _) => _); K{.native $parallel(f, b, o), .I I, .O o}}
plrun := k = K => a = (k.I _) => {r := $plrun(k.native, a, k.O); r : type_of (k.O); r = k.O}
range := x : Int => (($range(x) : Int) # 1)
row := cfg => (($row(cfg) : Int) # 1)
col := cfg => (($col(cfg) : Int) # 1)
Read := p = BufParam => {.from (Buf p) # warp, .at @any : Int}
Write := p = BufParam => {.to (Buf p) # warp, .at @any : Int, .value @any : p.type}
WriteAtomic := p = BufParam => {.to (Buf p) # warp, .at @any : Int, .value @any : p.type}
read := x = (Read _) => $read(x.from, x.at)
write := x = (Write _) => {r := $write(x.to, x.at, x.value); r = (Buf _) # (perspective_of x.to)}
write_atomic := x = (WriteAtomic _) => {r := $write_atomic(x.to, x.at, x.value); r = (Buf _) # (perspective_of x.to)}
collect := b = (Buf _) => $collect(b)
buf := x = BufParam => {b := Buf x; b.native = $buf(x.type, x.length); b}
Mma := {
  .s @any : string
  .a (Buf (BufParam{.type Int, .length 16})) # warp
  .b (Buf (BufParam{.type Int, .length 32})) # warp
  .c (Buf (BufParam{.type Int, .length 16})) # warp
}
mma := x = Mma => {r := $mma(x.s, x.a, x.b, x.c); r = (Buf (BufParam{.type Int, .length 16})) # warp}
graph := f => {f = (x => _); $graph(f)}
graphrun := g => a => $graphrun(g, a)
