---
  compute = import "compute.lichen"
---
In := {.d (compute.Buf (compute.BufParam{.type Float, .length 1}))}
OutE := {.e (compute.Buf (compute.BufParam{.type Float, .length 1}))}
Par := {.n @any : Int, .in In}
raw := ('lane = Par) => {
  e := compute.buf (compute.BufParam{.type Float, .length lane.n})
  ((OutE){.e (compute.write ((compute.Write _){.to e, .at 0, .value (compute.read ((compute.Read _){.from lane.in.d, .at 0}) : Float)}))})
}
k := compute.parallel raw "gpu" OutE
Arg := {.n @any : Int, .I In}
GArg := {.n @any : Int, .in In}
built := compute.graph (('a = GArg) => {
  (compute.plrun k ((Arg){.n a.n, .I a.in}) : Struct)
})
built
