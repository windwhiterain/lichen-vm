---
  compute = import "compute.lichen"
---
In = struct{.d (compute.Buf ((compute.BufParam _)(.type Float, .length 1)))}
OutE = struct{.e (compute.Buf ((compute.BufParam _)(.type Float, .length 1)))}
Par = struct{.n Int, .in In}
raw = (lane : Par) => {
  e = compute.buf ((compute.BufParam _)(.type Float, .length lane.n))
  ((OutE)(.e (compute.write ((compute.Write _)(.to e, .at 0, .value (compute.read ((compute.Read _)(.from lane.in.d, .at 0)) : Float))))))
}
k = compute.parallel raw "gpu" OutE
k
